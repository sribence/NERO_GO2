# Copy to .env next to docker-compose.yml and fill in.
# docker compose refuses to start without MC_API_TOKEN.

# Shared secret for every state-changing endpoint (arm / disarm / move / stop).
# POST /estop is deliberately exempt: it can only ever make the robot safer.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
MC_API_TOKEN=

# mock (default) | live. Only switch to live on the robot, and only after the
# telemetry field names have been verified -- see AUDIT-2026-09-10.md P0-2.
ROBOT_BACKEND=mock

WEBRTC_BRIDGE_URL=http://192.168.123.18:8000
DDS_NETWORK_IFACE=eth10

# Per-pillar /_debug/arm endpoints bypass core's shared arm state.
# Never set this to 1 outside local development.
MC_ENABLE_DEBUG_ENDPOINTS=0

# Velocity ceiling enforced by core and again by the live client.
MAX_VX=0.8
MAX_VY=0.4
MAX_VYAW=1.0

# Robot is stopped if no new move command arrives within this window.
COMMAND_TIMEOUT_S=0.5

# Comma-separated hostnames the orchestration call_api step may reach.
# Empty means "any public host"; internal/loopback addresses are always
# blocked unless ALLOW_PRIVATE_API_HOSTS=1.
ALLOWED_API_HOSTS=
ALLOW_PRIVATE_API_HOSTS=0

# Tailscale (only with the "remote" profile)
TS_AUTHKEY=
